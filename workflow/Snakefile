import os
from snakemake.utils import min_version, validate
min_version("9.3.3")

# Configuration is passed explicitly via --configfile (project configs or
# tests). A default here would be merged with --configfile values and can
# silently override sample lists when running tests.
if not config:
    raise SystemExit("No config provided. Run with --configfile <project.yaml>")


def normalize_sample_layouts(workflow_config):
    """Accept both flat single-sample and explicit-replicate layouts.

    Flat input such as ``sample: {R1: [...], R2: [...]}`` becomes one implicit
    replicate internally. The marker lets path helpers keep public output names
    as ``sample`` rather than exposing an artificial ``sample.rep1`` suffix.
    """
    assay_aliases = {
        "cut&run": "cutrun",
        "cut_run": "cutrun",
        "chip-seq": "chipseq",
        "chip_seq": "chipseq",
    }
    assay_type = str(workflow_config.get("assay_type", "cutrun")).lower()
    workflow_config["assay_type"] = assay_aliases.get(assay_type, assay_type)

    for sample, sample_cfg in workflow_config.get("samples", {}).items():
        if not isinstance(sample_cfg, dict):
            continue
        has_flat_reads = "R1" in sample_cfg or "R2" in sample_cfg
        has_replicates = "replicates" in sample_cfg
        if has_flat_reads and has_replicates:
            raise ValueError(
                f"samples.{sample}: use either direct R1/R2 or replicates, not both."
            )
        if has_flat_reads:
            read_cfg = {}
            for key in ("R1", "R2"):
                if key in sample_cfg:
                    read_cfg[key] = sample_cfg.pop(key)
            sample_cfg["replicates"] = {"rep1": read_cfg}
            sample_cfg["_implicit_single_replicate"] = True


normalize_sample_layouts(config)
validate(config, "schemas/config.schema.yaml")

include: "rules/common.smk"
include: "rules/qc_fastp.smk"
include: "rules/align_bowtie2.smk"
include: "rules/spikein.smk"
include: "rules/bam_to_bigwig.smk"
include: "rules/macs3.smk"
include: "rules/cutrun_qc.smk"
include: "rules/te_analysis.smk"

MULTIQC_TARGET = (
    f"{OUTDIR}/qc/multiqc/multiqc_report.html"
    if config.get("generate_multiqc", True)
    else None
)

PEAK_SAMPLES = [
    sample
    for sample in SAMPLES
    if config["samples"][sample].get("call_peaks", True)
]

PRIMARY_TARGETS = []
PRIMARY_TARGETS += expand(fastp_html("{run_sample}"), run_sample=RUN_SAMPLES)
PRIMARY_TARGETS += expand(fastp_json("{run_sample}"), run_sample=RUN_SAMPLES)
if MULTIQC_TARGET:
    PRIMARY_TARGETS.append(MULTIQC_TARGET)
if KEEP_BAM:
    PRIMARY_TARGETS += [final_bam_path(run_sample) for run_sample in RUN_SAMPLES]
    PRIMARY_TARGETS += [final_bai_path(run_sample) for run_sample in RUN_SAMPLES]
if GENERATE_RAW_BIGWIG:
    PRIMARY_TARGETS += expand(raw_bigwig_path("{run_sample}"), run_sample=RUN_SAMPLES)
if GENERATE_NORMALIZED_BIGWIG:
    PRIMARY_TARGETS += expand(normalized_bigwig_path("{run_sample}"), run_sample=RUN_SAMPLES)
    PRIMARY_TARGETS += [pooled_normalized_bigwig_path(sample) for sample in SAMPLES]
if SPIKEIN_ENABLED:
    PRIMARY_TARGETS += [spikein_scale_factor_path(run_sample) for run_sample in RUN_SAMPLES]
    PRIMARY_TARGETS.append(spikein_scale_factors_path())
    if SPIKEIN_BIGWIG_ENABLED:
        PRIMARY_TARGETS += [spikein_normalized_bigwig_path(run_sample) for run_sample in RUN_SAMPLES]
if CUTRUN_QC_ENABLED:
    PRIMARY_TARGETS += [cutrun_usable_fragments_path(run_sample) for run_sample in RUN_SAMPLES]
    PRIMARY_TARGETS += [fragment_length_path(run_sample) for run_sample in RUN_SAMPLES]
    PRIMARY_TARGETS.append(cutrun_qc_summary_path())
if MACS3_ENABLED:
    PEAK_RUN_SAMPLES = [
        rs
        for rs in RUN_SAMPLES
        if config["samples"][sample_of(rs)].get("call_peaks", True)
    ]
    PRIMARY_TARGETS += [macs3_narrow_path(rs) for rs in PEAK_RUN_SAMPLES]
    PRIMARY_TARGETS += [macs3_summits_path(rs) for rs in PEAK_RUN_SAMPLES]
    PRIMARY_TARGETS += [macs3_xls_path(rs) for rs in PEAK_RUN_SAMPLES]
    PRIMARY_TARGETS += [macs3_narrow_path(sample, pooled=True) for sample in PEAK_SAMPLES]
    PRIMARY_TARGETS += [macs3_summits_path(sample, pooled=True) for sample in PEAK_SAMPLES]
    PRIMARY_TARGETS += [replicate_concordance_path(sample) for sample in PEAK_SAMPLES]
    PRIMARY_TARGETS += [macs3_consensus_path(sample) for sample in PEAK_SAMPLES if len(REPLICATES[sample]) >= 2]
    PRIMARY_TARGETS += [frip_path(rs) for rs in PEAK_RUN_SAMPLES]
    PRIMARY_TARGETS += [frip_path(sample, pooled=True) for sample in PEAK_SAMPLES]
    PRIMARY_TARGETS.append(frip_summary_path())
if TE_ENABLED:
    for run_sample in RUN_SAMPLES:
        PRIMARY_TARGETS += te_paths(run_sample)
    if TE_ANNOTATION:
        PRIMARY_TARGETS.append(te_overlap_summary_path())
        PRIMARY_TARGETS.append(te_overlap_mqc_path())
        PRIMARY_TARGETS.append(te_enrichment_path())
        PRIMARY_TARGETS.append(te_enrichment_path().replace(".tsv", ".curated.tsv"))
        PRIMARY_TARGETS.append(te_enrichment_path().replace(".tsv", ".novel.tsv"))
        PRIMARY_TARGETS.append(te_enrichment_path().replace(".tsv", ".unknown.tsv"))
        PRIMARY_TARGETS.append(te_enrichment_path().replace(".tsv", ".subclass.tsv"))
        if TE_BLACKLIST_MODE == "full" and FILTER_BLACKLIST:
            PRIMARY_TARGETS.append(te_blacklist_lowconf_path())

rule all:
    input:
        PRIMARY_TARGETS
